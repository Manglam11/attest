# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- Virtual environments ----
venv/
.venv/
env/

# ---- Data & corpus (bulky, re-scrapeable) ----
# NOTE: 'data/*' not 'data/' — a trailing slash stops git descending into the
# folder at all, which kills every '!' exception below it.
data/*
media/
*.pdf
uploads/
aapl_extracted.txt
!docs/blueprint.pdf

# ---- Eval evidence: judged results ARE committed, raw runs are not ----
!data/eval/
data/eval/*
!data/eval/judged_*.json
!data/eval/latency_samples.json
!data/eval/retrieval_baseline_*.json
!data/eval/context_precision_proxy_*.json

# ---- Corpus: real filings, re-fetchable, never committed ----
!data/corpus/
data/corpus/*
!data/corpus/.gitkeep

# ---- Container data volumes (re-buildable) ----
qdrant_storage/
postgres_data/
pgdata/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
*.log