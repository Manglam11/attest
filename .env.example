# Postgres — copy to .env and fill real values
POSTGRES_USER=attest
POSTGRES_PASSWORD=change_me
POSTGRES_DB=attest
GEMINI_API_KEY=paste_your_key_here
JUDGE_API_KEY=<your original key>

# Qdrant — defaults match the compose service name/port; override to point
# at a managed instance
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Shared HMAC secret — shell mints, engine verifies. Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SIGNING_SECRET=change_me

# alice's demo login — not a real secret's format, just the current fixture password
DEMO_ALICE_PASSWORD=change_me